{
  "name": "foyer-budget",
  "version": "1.0.0",
  "private": true,
  "description": "Application de gestion de budget de foyer (3 comptes prelevements + 1 compte entrees)",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev:backend": "npm run start:dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "build:frontend": "npm run build --workspace=frontend",
    "build:backend": "npm run build --workspace=backend",
    "build": "npm run build:frontend && npm run build:backend",
    "test:backend": "npm run test --workspace=backend",
    "test:frontend": "npm run test --workspace=frontend",
    "test": "npm run test:backend && npm run test:frontend",
    "typecheck": "npm run typecheck --workspace=backend && npx tsc -b --noEmit frontend",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=26"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2007"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,json,md,yml,yaml,css,html}": [
      "oxfmt --no-error-on-unmatched-pattern"
    ]
  }
}
