# Copiez ce fichier en .env (jamais commite) et completez les valeurs.

# Mode d'authentification : oauth (defaut, auth.sloboda.fr) ou dev (connexion
# factice alice/bob pour developper et tester ; REFUSE de demarrer en production).
AUTH_MODE=oauth
# Mode dev uniquement : secret de signature des jetons factices.
DEV_AUTH_SECRET=

# Obligatoire en production - cle maitre du chiffrement de l'espace personnel :
# 32 octets : 64 caracteres hexadecimaux (openssl rand -hex 32) ou base64 (openssl rand -base64 32). Perdue = donnees personnelles
# illisibles : a conserver dans 1Password avec les autres secrets.
PERSONAL_DATA_KEY=

# Requis en mode oauth - service d'authentification central (auth.sloboda.fr)
AUTH_SERVICE_URL=https://auth.sloboda.fr
AUTH_CLIENT_ID=budget
AUTH_CLIENT_SECRET=change-me

# Requis - secret partage avec auth-service pour le webhook de revocation
# (POST /api/auth/disconnect?secret=..., appele de serveur a serveur : hors SameOriginGuard)
AUTH_WEBHOOK_SECRET=change-me

# Optionnel - secret de signature du webhook de deconnexion (64 caracteres hexadecimaux en minuscules, affiche une
# seule fois par l'admin home-auth). Absent : seul l'ancien ?secret= authentifie le webhook.
# Avec lui, la signature X-Auth-Webhook-* est acceptee ; flag auth-webhook-require-signature a true :
# elle devient obligatoire.
AUTH_WEBHOOK_SIGNING_SECRET=

# Optionnel - base URL du frontend, utilisee pour le redirect_uri OAuth2
FRONTEND_URL=http://localhost:3000

# Production - secret HMAC des pseudonymes dans les logs (openssl rand -hex 32).
# Sans lui, les logs n'identifient aucun utilisateur.
PSEUDONYM_SECRET=

# Optionnel - telemetrie anonyme (PostHog) : evenements produit et operationnels (runtime_health
# toutes les 60 s, http_request par route Nest). Sans POSTHOG_API_KEY, aucun evenement n'est
# envoye (adaptateur NOOP). Le membre n'apparait que sous pseudonyme (PSEUDONYM_SECRET) ;
# les evenements operationnels n'ont aucun utilisateur.
POSTHOG_API_KEY=
POSTHOG_HOST=https://eu.i.posthog.com

# Optionnel - feature flags home-features (OFREP). Absentes ou invalides : flags desactives,
# le defaut du code s'applique (le demarrage n'est jamais bloque). URL en https en production ;
# cle d'API serveur liee a l'app et a l'environnement (hf_ + 64 hex).
FEATURES_OFREP_URL=
FEATURES_API_KEY=
# Pin d'urgence d'un flag, prioritaire sur home-features : FEATURES_PIN_<CLE_EN_MAJ_SNAKE>=true|false
# ex. FEATURES_PIN_AUTH_VERIFY_TOKEN_CLAIMS=false

# Optionnel - chemin du fichier SQLite
DATABASE_PATH=

# Optionnel
NODE_ENV=development
PORT=3000

# Optionnel - replication Litestream de la DB SQLite vers MinIO (S3-compatible)
# Si MINIO_BUCKET est defini, le conteneur restaure la DB au demarrage et la
# replique en continu.
MINIO_ENDPOINT=
MINIO_BUCKET=
MINIO_REPLICA_PATH=foyer-budget
MINIO_REGION=us-east-1
MINIO_ACCESS_KEY_ID=
MINIO_SECRET_ACCESS_KEY=
